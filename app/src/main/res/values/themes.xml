<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Use Material Components theme for Material Design components -->
    <style name="Theme.MyBooks" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">#6200EE</item>
        <item name="colorPrimaryVariant">#3700B3</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#03DAC5</item>
        <item name="colorSecondaryVariant">#018786</item>
        <item name="colorOnSecondary">#000000</item>
    </style>


    <style name="labelDesign">
        <item name="android:textColor">@color/black_grey_light</item>
        <item name="android:fontFamily">@font/raleway_bold</item>
        <item name="android:textSize">@dimen/_18sdp</item>
    </style>


    <style name="textFieldLabelDesign">
        <item name="android:textColor">@color/text_field_label_color</item>
        <item name="android:fontFamily">@font/raleway_semibold</item>
        <item name="android:textSize">@dimen/_12sdp</item>
    </style>


    <style name="editTextDesign">
        <item name="android:background">@drawable/text_field_bg</item>
        <item name="android:fontFamily">@font/raleway</item>
        <item name="android:textSize">@dimen/_12sdp</item>
        <item name="android:inputType">text</item>
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
        <item name="android:textCursorDrawable">@drawable/cursor_bg</item>
        <item name="android:paddingHorizontal">@dimen/_10sdp</item>
        <item name="android:paddingVertical">@dimen/_10sdp</item>
        <item name="android:layout_marginTop">@dimen/_5sdp</item>
    </style>


    <style name="buttonDesign">
        <item name="android:background">@drawable/btn_bg</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">@font/raleway_bold</item>
        <item name="android:textSize">@dimen/_14sdp</item>
        <item name="android:paddingHorizontal">@dimen/_10sdp</item>
        <item name="android:paddingVertical">@dimen/_12sdp</item>
    </style>


    <style name="guestButtonDesign">
        <item name="android:background">@drawable/guest_btn_bg</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textColor">@color/text_field_label_color</item>
        <item name="android:fontFamily">@font/raleway</item>
        <item name="android:textSize">@dimen/_14sdp</item>
        <item name="android:paddingHorizontal">@dimen/_10sdp</item>
        <item name="android:paddingVertical">@dimen/_12sdp</item>
    </style>


    <style name="BottomRoundedShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeBottomLeft">16dp</item>
        <item name="cornerSizeBottomRight">16dp</item>
    </style>


    <style name="yellowButtonDesign">
        <item name="android:background">@drawable/yellow_btn_bg</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">@font/raleway</item>
        <item name="android:textSize">@dimen/_14sdp</item>
        <item name="android:paddingHorizontal">@dimen/_10sdp</item>
        <item name="android:paddingVertical">@dimen/_12sdp</item>
    </style>


    <style name="buttonRadiusDesign">
        <item name="android:background">@drawable/btn_rounded_bg</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">@font/raleway_semibold</item>
        <item name="android:textSize">@dimen/_8sdp</item>
        <item name="android:paddingHorizontal">@dimen/_8sdp</item>
        <item name="android:paddingVertical">@dimen/_6sdp</item>
    </style>

</resources>