<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white">

    <RelativeLayout
        android:id="@+id/rl_nav_header_img"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/_20sdp"
        android:paddingHorizontal="@dimen/_10sdp"
        android:background="@color/btn_color">

        <ImageView
            android:id="@+id/ivBackMenu"
            android:layout_width="@dimen/_35sdp"
            android:layout_height="@dimen/_35sdp"
            android:layout_margin="@dimen/_15sdp"
            android:src="@drawable/ic_back_menu" />


        <androidx.cardview.widget.CardView
            android:id="@+id/profileCard"
            android:layout_width="@dimen/_50sdp"
            android:layout_height="@dimen/_50sdp"
            android:layout_below="@+id/ivBackMenu"
            app:cardCornerRadius="@dimen/_15sdp"
            android:layout_marginStart="@dimen/_8sdp"
            app:cardElevation="0dp"
            >
            <ImageView
                android:id="@+id/profileImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_user_image"
                />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tvUserName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/labelDesign"
            android:layout_toEndOf="@+id/profileCard"
            android:layout_below="@+id/ivBackMenu"
            android:text="@string/str_test_user_name"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:textColor="@color/white"
            />

    </RelativeLayout>

</RelativeLayout>